@model PreviewSimulationViewModel
@using System.Globalization
@using FinSight.Domain.Enums
@{ ViewData["Title"] = T["Simulate your financial decisions"].Value; }
<section class="panel message-panel simulation-panel">
    <h1>@T["Simulate your financial decisions"]</h1>
    <partial name="_DecisionCards" model="@(new DecisionCardsViewModel("pricing", Model.ProductId))" />
    <p class="eyebrow">@T["EXPLORE BEFORE YOU CHANGE"]</p>
    <h2>@T["Preview a price change"]</h2>
    <h2><bdi>@Model.ProductName</bdi></h2>
    <p>@T["Compare sales over the same period. This preview never saves a simulation or changes your product."]</p>
    <dl class="simulation-product-facts">
        <div><dt>@T["Current selling price"]</dt><dd><bdi dir="ltr">@Model.CurrentPrice.ToString("N2") @Model.Currency</bdi></dd></div>
        <div><dt>@T["Unit cost"]</dt><dd><bdi dir="ltr">@Model.UnitCost.ToString("N2") @Model.Currency</bdi></dd></div>
        <div><dt>@T["Business currency"]</dt><dd><bdi dir="ltr">@Model.Currency</bdi></dd></div>
    </dl>
    <form method="post" asp-action="Preview" data-decision-form data-has-draft="@((Context.Request.Method == "POST").ToString().ToLowerInvariant())">
        <div asp-validation-summary="All" role="alert"></div>
        <input asp-for="ProductId" type="hidden" />
        <div class="field-grid">
            <div class="field"><label asp-for="ProposedPrice"></label><input asp-for="ProposedPrice" type="text" inputmode="decimal" dir="ltr" required /><span asp-validation-for="ProposedPrice"></span></div>
            <div class="field"><label for="CurrentSalesQuantity">@T["Current units sold"]</label><input asp-for="CurrentSalesQuantity" type="text" inputmode="numeric" dir="ltr" required /><span asp-validation-for="CurrentSalesQuantity"></span><small>@T["Example: 33 units sold in one selected period."]</small></div>
            <div class="field"><label asp-for="ComparisonPeriod"></label><select asp-for="ComparisonPeriod">
                <option value="Day">@T["day"]</option><option value="Week">@T["week"]</option><option value="Month">@T["month"]</option>
            </select><span asp-validation-for="ComparisonPeriod"></span></div>
            <div class="field"><label asp-for="DeclinePercentage"></label><input asp-for="DeclinePercentage" type="text" inputmode="numeric" dir="ltr" required /><span asp-validation-for="DeclinePercentage"></span><small>@T["10% is illustrative, not a prediction."]</small></div>
        </div>
        <div class="field"><label class="checkbox-label"><input asp-for="UnknownExpectedSales" type="checkbox" /> @T["I don't know expected sales"]</label></div>
        <div class="field" data-expected-field hidden="@Model.UnknownExpectedSales"><label for="ExpectedSalesQuantity">@T["Expected units sold"]</label><input asp-for="ExpectedSalesQuantity" type="text" inputmode="numeric" dir="ltr" disabled="@Model.UnknownExpectedSales" required="@(!Model.UnknownExpectedSales)" /><span asp-validation-for="ExpectedSalesQuantity"></span><small>@T["Optional when you do not know. If entered, this is your assumption, not a forecast."]</small></div>
        <p class="form-guidance">@T["All quantities refer to the selected period. Unit cost is assumed unchanged."]</p>
        <div class="field"><label asp-for="AdditionalDecisionCost"></label><input asp-for="AdditionalDecisionCost" type="text" inputmode="decimal" dir="ltr" /><span asp-validation-for="AdditionalDecisionCost"></span><small>@T["Only extra expenses caused by this decision for the selected period. Do not repeat existing bills or unit costs. Blank excludes unknown costs; 0 confirms none."]</small></div>
        <partial name="_CostLinkForm" model="Model" />
        <button class="button" type="submit">@T["Calculate preview"]</button>
    </form>
    @if (ViewData.ModelState.IsValid && Model.Result is { } decision)
    {
        <result-modal id="pricing-result" title="@T["Preview a price change"]" source-form="[data-decision-form]" return-focus="[data-decision-form] button[type=submit]" auto-open="@ViewData.ModelState.IsValid">
        <div data-decision-results>
            <partial name="_DecisionResult" model="@(new DecisionDisplayViewModel(decision, Model.ComparisonPeriod, Model.CurrentPrice, Model.ProposedPrice, Model.CurrentSalesQuantity, Model.ExpectedSalesQuantity, Model.DeclinePercentage, Model.Currency))" />
            <partial name="_LinkedCostResult" model="@(new CostContextDisplayModel(Model.CostContext, Model.Currency))" />
            <form method="post" asp-action="Save" data-decision-save>
                @if (Model.CostContext is not null) { <partial name="_CostLinkHidden" model="Model.CostContext" /> }
                <input type="hidden" name="AdditionalDecisionCost" value="@Model.AdditionalDecisionCost?.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="ProductId" value="@Model.ProductId" />
                <input type="hidden" name="ProposedPrice" value="@Model.ProposedPrice.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="CurrentSalesQuantity" value="@Model.CurrentSalesQuantity" />
                @if (Model.ExpectedSalesQuantity.HasValue)
                { <input type="hidden" name="ExpectedSalesQuantity" value="@Model.ExpectedSalesQuantity.Value" /> }
                <input type="hidden" name="ComparisonPeriod" value="@Model.ComparisonPeriod" />
                <input type="hidden" name="DeclinePercentage" value="@Model.DeclinePercentage" />
                <input type="hidden" name="PreviewCurrentPrice" value="@Model.CurrentPrice.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="PreviewUnitCost" value="@Model.UnitCost.ToString(CultureInfo.InvariantCulture)" />
                <button class="button" type="submit">@T["Save this simulation"]</button>
                <small>@T["Saving is explicit. Preview alone never creates a history record."]</small>
            </form>
        </div>
        </result-modal>
    }
    <p><a href="/products">@T["Choose another product"]</a></p>
    <p><a href="/business-costs">@T["Business costs"]</a> — @T["A full business operating result requires sales and costs across the business for the same period."]</p>
</section>
<script src="~/js/simulation-preview.js" asp-append-version="true" defer></script>
