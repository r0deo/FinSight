@model PreviewSimulationViewModel
@{ ViewData["Title"] = T["Preview a price change"].Value; }
<section class="panel message-panel">
    <p class="eyebrow">@T["EXPLORE BEFORE YOU CHANGE"]</p><h1>@T["Preview a price change"]</h1>
    <h2><bdi>@Model.ProductName</bdi></h2>
    <p>@T["Compare sales over the same period. This preview never saves a simulation or changes your product."]</p>
    <form method="post" asp-action="Preview">
        <div asp-validation-summary="All" role="alert"></div>
        <input asp-for="ProductId" type="hidden" />
        <div class="field"><label asp-for="ProposedPrice"></label><input asp-for="ProposedPrice" type="text" inputmode="decimal" dir="ltr" required /><span asp-validation-for="ProposedPrice"></span></div>
        <div class="field"><label asp-for="CurrentSalesQuantity"></label><input asp-for="CurrentSalesQuantity" type="text" inputmode="numeric" dir="ltr" required /><span asp-validation-for="CurrentSalesQuantity"></span></div>
        <div class="field"><label asp-for="ExpectedSalesQuantity"></label><input asp-for="ExpectedSalesQuantity" type="text" inputmode="numeric" dir="ltr" required /><span asp-validation-for="ExpectedSalesQuantity"></span></div>
        <button class="button" type="submit">@T["Calculate preview"]</button>
    </form>
    @if (Model.Result is { } result)
    {
        <section aria-label="@T["Calculation result"]" role="status">
            <h2>@T["Preview result"]</h2>
            <dl><dt>@T["Current contribution"]</dt><dd><bdi>@result.CurrentContribution.ToString("N2")</bdi></dd>
                <dt>@T["Proposed contribution"]</dt><dd><bdi>@result.ProposedContribution.ToString("N2")</bdi></dd>
                <dt>@T["Difference"]</dt><dd><bdi>@result.Difference.ToString("N2")</bdi></dd>
                <dt>@T["Recommendation"]</dt><dd>@T[result.Recommendation == FinSight.Domain.Enums.Recommendation.Recommended ? "Recommended" : "Not recommended"]</dd></dl>
            @if (result.IsProposedPriceBelowCost) { <p role="alert">@T["Warning: the proposed price is below unit cost."]</p> }
        </section>
    }
    <p><a href="/products">@T["Choose another product"]</a></p>
</section>
