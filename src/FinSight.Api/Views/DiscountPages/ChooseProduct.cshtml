@model FinSight.Application.Features.Products.Queries.GetProducts.GetProductsResponse
@{ ViewData["Title"] = T["Offer a discount"].Value; }
<section class="panel simulation-panel">
    <nav class="actions" aria-label="@T["Simulation tools"]"><a href="/simulations/preview">@T["Change selling price"]</a><span aria-current="page">@T["Offer a discount"]</span></nav>
    <h1>@T["Offer a discount"]</h1><h2>@T["Choose a product"]</h2>
    @if (Model.Items.Count == 0) { <p>@T["No active products are available for a discount simulation."]</p><a class="button" href="/products">@T["Manage products"]</a> }
    @foreach (var product in Model.Items)
    { <article class="saved-simulation-card"><a href="/simulations/discount?productId=@product.Id"><bdi>@product.Name</bdi></a></article> }
    <nav class="pagination" aria-label="@T["Pagination"]">
        @if (Model.Page > 1) { <a href="/simulations/discount?page=@(Model.Page - 1)">@T["Previous"]</a> }
        @if (Model.Page < Model.TotalPages) { <a href="/simulations/discount?page=@(Model.Page + 1)">@T["Next"]</a> }
    </nav>
</section>
