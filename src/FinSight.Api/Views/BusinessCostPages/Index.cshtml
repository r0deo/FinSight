@model BusinessCostsViewModel
@{ ViewData["Title"] = T["Business costs"].Value; var month = Model.Summary.Month.ToString("yyyy-MM"); }
<section class="panel"><h1>@T["Business costs"]</h1>
<form method="get" class="filters"><div class="field"><label for="month">@T["month"]</label><input id="month" name="month" type="month" min="2000-01" max="2100-12" value="@month" required dir="ltr" /></div><button class="button button-quiet button-small" type="submit">@T["View month"]</button></form>
<p><a class="button" href="/business-costs/create?month=@month">@T["Add cost entry"]</a></p>
<partial name="_BusinessCostSummary" model="Model" />
<h2>@T["Cost entries"]</h2>
<div class="what-if-options">
@foreach(var c in Model.Summary.Entries) {
<article class="panel"><h3><bdi>@c.Name</bdi></h3><p>@T[CostLabels.Category(c.Category)]</p>
<p><bdi dir="ltr">@c.Amount.ToString("N2") @Model.Currency</bdi> · @T[c.Certainty.ToString()]</p>
<p>@T["Already included in product unit costs?"] @T[c.Inclusion.ToString()]</p>
@if(c.Note is not null) { <p><bdi>@c.Note</bdi></p> }
<a href="/business-costs/@c.Id/edit">@T["Edit"]</a> · <a href="/business-costs/@c.Id/delete">@T["Delete cost entry"]</a></article>
}
</div>
<aside class="notice"><h2>@T["Avoid counting the same cost twice"]</h2>
<p>@T["Unit costs describe the cost associated with each product unit. Monthly operating costs may continue even when sales change. Buying inventory is not the same as consuming or selling it."]</p>
<p>@T["Check missing categories, estimates, and Unsure entries. A full business operating result requires sales and costs across the business for the same period."]</p></aside>
</section>
