@model bool
@inject Microsoft.Extensions.Options.IOptions<FinSight.Infrastructure.Identity.GoogleSignInOptions> GoogleOptions
@{ ViewData["Title"] = T["Account settings"].Value; }
<section class="panel message-panel">
    <p class="eyebrow">@T["YOUR ACCOUNT"]</p><h1>@T["Account settings"]</h1>
    @if (Model)
    {
        <h2>@T["Google connected"]</h2>
        <p>@T["You can sign in with your connected Google account. Your business and role stay the same."]</p>
    }
    else if (GoogleOptions.Value.Enabled)
    {
        <h2>@T["Connect Google"]</h2>
        <p>@T["Optionally use Google to sign in to this account. This does not create another business or change your role."]</p>
        <form asp-controller="GoogleAccount" asp-action="StartLink" method="post">
            <button class="button" type="submit">@T["Connect Google"]</button>
        </form>
    }
    else
    {
        <p>@T["Google is not connected. Connecting Google is currently unavailable."]</p>
    }
    <p><a href="/home">@T["Back to home"]</a></p>
</section>
