@model RegisterViewModel
@{ ViewData["Title"] = T["Create your business"].Value; }
<section class="auth-layout register-layout">
    <div class="auth-intro"><p class="eyebrow">@T["MAKE ROOM FOR CLARITY"]</p><h1>@T["Your menu."] <br />@T["Your workspace."]</h1><p class="lead">@T["Use your Google account to access Rebaz."]</p><p class="muted">@T["You'll be the Owner of this business. Existing Owners and Managers can use the login page."]</p></div>
    <div class="panel auth-panel">
        <h2>@T["Create your business"]</h2>
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <partial name="_GoogleButton" />
        <p class="form-footer">@T["Already registered?"] <a href="/account/login">@T["Log in"]</a></p>
    </div>
</section>
