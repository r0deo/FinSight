@model ResendConfirmationViewModel
@inject Microsoft.Extensions.Options.IOptions<FinSight.Infrastructure.Identity.EmailOptions> EmailOptions
@{ ViewData["Title"] = T["Resend confirmation"].Value; }
<section class="panel message-panel"><h1>@T["Need a new link?"]</h1>
    <partial name="_EmailAvailability" />
    @if (EmailOptions.Value.Enabled)
    {
    <p class="lead">@T["Enter your account email. If it needs confirmation, we'll send a new link. You can try up to three times every 15 minutes."]</p>
    <form asp-action="ResendConfirmation" method="post">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" dir="ltr" /><span asp-validation-for="Email"></span></div>
        <button class="button" type="submit">@T["Send confirmation email"]</button>
    </form>
    }
    <p><a href="/account/login">@T["Back to login"]</a></p>
</section>
