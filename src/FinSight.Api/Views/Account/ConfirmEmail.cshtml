@{ ViewData["Title"] = T["Confirm your email"].Value; }
<section class="panel message-panel">
    <p class="eyebrow">@T["WELCOME TO REBAZ"]</p><h1>@T["Confirm your email."]</h1>
    <p class="lead">@T["Secure your account, then start building your product list."]</p>
    <form asp-action="ConfirmEmail" method="post">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <button class="button" type="submit">@T["Confirm email & continue"]</button>
    </form>
</section>
