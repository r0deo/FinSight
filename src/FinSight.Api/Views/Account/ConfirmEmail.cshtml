@{ ViewData["Title"] = "Confirm your email"; }
<section class="panel message-panel">
    <p class="eyebrow">WELCOME TO FINSIGHT</p><h1>Confirm your email.</h1>
    <p class="lead">Secure your account, then start building your product list.</p>
    <form asp-action="ConfirmEmail" method="post">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <button class="button" type="submit">Confirm email & continue</button>
    </form>
</section>
