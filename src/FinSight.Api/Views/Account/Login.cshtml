@model LoginViewModel
@{ ViewData["Title"] = T["Welcome back"].Value; }
<section class="auth-layout">
    <div class="auth-intro"><p class="eyebrow">@T["YOUR BUSINESS, IN FOCUS"]</p><h1>@T["Welcome"] <br />@T["back."]</h1><p class="lead">@T["Pick up where you left off. Your menu is ready when you are."]</p></div>
    <div class="panel auth-panel">
        <h2>@T["Log in to Rebaz"]</h2><p class="muted">@T["Use your Google account to access Rebaz."]</p>
        @if (!string.IsNullOrEmpty(Context.Request.Query["returnUrl"]))
        { <p role="status">@T["Sign in to continue. Your previous session may have expired."]</p> }
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <partial name="_GoogleButton" />
    </div>
</section>
