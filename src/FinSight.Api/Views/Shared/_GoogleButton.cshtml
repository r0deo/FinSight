@inject Microsoft.Extensions.Options.IOptions<FinSight.Infrastructure.Identity.GoogleSignInOptions> GoogleOptions
@if (GoogleOptions.Value.Enabled)
{
    <form asp-controller="GoogleAccount" asp-action="Start" method="post" class="google-signin">
        <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
        <button class="button button-secondary full-width" type="submit">Continue with Google</button>
    </form>
}
