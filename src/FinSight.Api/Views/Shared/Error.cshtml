@model WebsiteErrorViewModel
@{ ViewData["Title"] = Model.Title; }
<section class="panel message-panel"><p class="eyebrow">@Model.StatusCode</p><h1>@T[Model.Title]</h1><p class="lead">@T[Model.Message]</p><div class="actions"><a class="button" href="/products">@T["Go to products"]</a><a href="/account/login">@T["Log in"]</a></div></section>
