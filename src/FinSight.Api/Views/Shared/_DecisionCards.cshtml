@model DecisionCardsViewModel
@{
    var cards = new[] {
        (Id: "pricing", Title: "Price", Description: "Compare selling prices."),
        (Id: "discount", Title: "Discount", Description: "Explore a lower price."),
        (Id: "delivery", Title: "Delivery app", Description: "Account for app fees.")
    };
}
<h2 class="decision-step">@T["Step 2: Choose a decision"]</h2>
<nav class="decision-cards" aria-label="@T["Simulation type"]" data-decision-cards data-discard-warning="@T["Switching decisions will discard your unsaved inputs. Continue?"]">
    @foreach (var card in cards)
    {
        var selected = Model.ProductId.HasValue && card.Id == Model.Selected;
        var target = DecisionCardsViewModel.Route(card.Id) + $"?productId={Model.ProductId}";
        if (Model.ProductId.HasValue)
        {
            <a class="decision-card @(selected ? "is-selected" : "")" href="@target" data-decision-link="@card.Id" aria-current="@(selected ? "page" : null)">
                <strong>@T[card.Title]</strong><span>@T[card.Description]</span>
            </a>
        }
        else
        {
            <span class="decision-card" aria-disabled="true"><strong>@T[card.Title]</strong><span>@T[card.Description]</span></span>
        }
    }
</nav>
