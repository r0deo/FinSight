@model DecisionDisplayViewModel
@using FinSight.Domain.Enums
@{
    var period = Model.Period switch {
        SalesPeriod.Day => T["day"].Value,
        SalesPeriod.Week => T["week"].Value,
        SalesPeriod.Month => T["month"].Value,
        _ => T["Period not specified"].Value
    };
    var d = Model.Decision;
}
<section class="decision-results" aria-label="@T["Calculation result"]" role="status">
    <h2>@(Model.IsHistorical ? T["Saved result"] : T["Preview result"])</h2>
    <div class="decision-answer">
        <p class="eyebrow">@T["Minimum units sold to maintain your current contribution"]</p>
        @if (d.ThresholdStatus == MaintenanceThresholdStatus.Available)
        {
            @if (Model.Period.HasValue)
            {
                <h2><bdi dir="ltr">@d.MinimumSalesToMaintainContribution?.ToString("N0")</bdi> @T["units each {0}", period]</h2>
                <p>@T["At this price, you need at least {0} units sold per {1} to maintain your current contribution.", d.MinimumSalesToMaintainContribution!.Value.ToString("N0"), period]</p>
            }
            else
            {
                <h2><bdi dir="ltr">@d.MinimumSalesToMaintainContribution?.ToString("N0")</bdi> @T["units sold (period not specified)"]</h2>
                <p>@T["At this price, you need at least {0} units sold to maintain your current contribution. The period was not saved.", d.MinimumSalesToMaintainContribution!.Value.ToString("N0")]</p>
            }
            @if (d.QuantityChange < 0)
            {
                <p>@T["You could sell {0} fewer units than today and maintain contribution.", (-d.QuantityChange!.Value).ToString("N0")]
                    @if (d.QuantityChangePercent.HasValue) { <span>(@((-d.QuantityChangePercent.Value).ToString("N1"))%)</span> }</p>
            }
            else if (d.QuantityChange > 0)
            {
                <p>@T["You would need {0} additional units compared with today.", d.QuantityChange!.Value.ToString("N0")]
                    @if (d.QuantityChangePercent.HasValue) { <span>(@(d.QuantityChangePercent.Value.ToString("N1"))%)</span> }</p>
            }
            else { <p>@T["You still need the same sales quantity as today."]</p> }
        }
        else if (d.ThresholdStatus == MaintenanceThresholdStatus.ImpossibleAtPrice)
        { <h2>@T["Not possible at this price"]</h2><p>@T["The proposed price has no positive contribution per unit, so it cannot maintain today's positive contribution."]</p> }
        else if (d.ThresholdStatus == MaintenanceThresholdStatus.OutsideSupportedQuantity)
        { <h2>@T["Beyond the supported quantity"]</h2><p>@T["Maintaining today's contribution would require more units than this calculator supports."]</p> }
        else
        { <h2>@T["No positive contribution to preserve"]</h2><p>@T["The current situation has zero or negative contribution. A standard maintenance threshold would be misleading; check costs and the scenarios below."]</p> }
    </div>
    @if (d.IsProposedPriceBelowCost)
    { <div class="notice notice-warning" role="alert">@T["Warning: the proposed price is below unit cost."] @T["Every unit sold at this price contributes negatively before other expenses."]</div> }
    @if (d.ExpectedScenario is { } expected)
    {
        <p>@T["Your expected sales"]: <bdi>@expected.Quantity.ToString("N0")</bdi></p>
        <partial name="_PeriodImpact" model="@((expected.Difference, Model.Currency, Model.Period.HasValue ? period : (string?)null))" />
        @if (Model.CurrentPrice == Model.ProposedPrice && d.AdditionalDecisionCost is null or 0)
        { <p>@T["The price is unchanged; any difference comes from the sales quantity you assumed."]</p> }
    }
    else
    {
        <p>@T["No expected sales were entered, so there is no personal forecast or overall recommendation."]</p>
        <p>@T["If sales stay the same"]</p>
        <partial name="_PeriodImpact" model="@((d.Scenarios.First(x => x.Kind == PricingScenarioKind.SameSales).Difference, Model.Currency, Model.Period.HasValue ? period : (string?)null))" />
    }
    <p class="form-guidance">@T["Contribution means the amount left after the costs entered in this comparison. It helps cover other business expenses; it is not net profit."]</p>
    <details class="result-details" data-result-details><summary>@T["See details"]</summary>
    <p>@T["Additional decision cost for this period (optional)"]: @if (d.AdditionalDecisionCost is { } extra) { <bdi dir="ltr" data-decision-cost>@extra.ToString("N2") @Model.Currency</bdi> } else { @T["Additional decision costs are unknown or excluded."] }</p>
    @if (d.AdditionalDecisionCost.HasValue) { <p>@T["Scenario contributions and minimum-sales thresholds include this additional cost once; it does not reduce the current contribution."]</p> }
    <h3>@T["Scenario comparison"]</h3>
    @if (Model.Period.HasValue) { <p>@T["All scenario amounts are per {0}.", period]</p> }
        <p>@T["The decline scenario is an illustration, not a demand prediction. Fractional units are rounded down."]</p>
    <div class="table-scroll"><table class="scenario-table">
        <thead><tr><th scope="col">@T["Scenario"]</th><th scope="col">@T["Units sold"]</th><th scope="col">@T["Revenue"]</th><th scope="col">@T["Entered unit costs"]</th><th scope="col">@T["Left after unit costs"]</th>@if (d.AdditionalDecisionCost.HasValue) { <th scope="col">@T["Left after product and decision costs"]</th> }<th scope="col">@T["Difference"]</th><th scope="col">@T["Compared with today"]</th></tr></thead>
        <tbody>
        @foreach (var scenario in d.Scenarios)
        {
            var label = scenario.Kind switch {
                PricingScenarioKind.SameSales => T["Same sales quantity as today"].Value,
                PricingScenarioKind.LowerSales => T["Sales decline ({0}% illustrative)", Model.DeclinePercentage.GetValueOrDefault()].Value,
                _ => T["Your expected sales"].Value
            };
            var comparison = scenario.Difference > 0 ? T["Higher contribution"].Value
                : scenario.Difference < 0 ? T["Lower contribution"].Value : T["Unchanged contribution"].Value;
            <tr>
                <th scope="row">@label</th>
                <td data-label="@T["Units sold"]"><bdi dir="ltr">@scenario.Quantity.ToString("N0")</bdi></td>
                <td data-label="@T["Revenue"]"><bdi dir="ltr">@scenario.Revenue.ToString("N2") @Model.Currency</bdi></td>
                <td data-label="@T["Entered unit costs"]"><bdi dir="ltr">@scenario.TotalUnitCosts.ToString("N2") @Model.Currency</bdi></td>
                <td data-label="@T["Left after unit costs"]"><bdi dir="ltr">@((scenario.Revenue - scenario.TotalUnitCosts).ToString("N2")) @Model.Currency</bdi></td>
                @if (d.AdditionalDecisionCost.HasValue) { <td data-label="@T["Left after product and decision costs"]"><bdi dir="ltr">@scenario.Contribution.ToString("N2") @Model.Currency</bdi></td> }
                <td data-label="@T["Difference"]"><bdi dir="ltr">@((scenario.Difference > 0 ? "+" : "") + scenario.Difference.ToString("N2")) @Model.Currency</bdi></td>
                <td data-label="@T["Compared with today"]">@comparison</td>
            </tr>
        }
        </tbody>
    </table></div>
    <div class="decision-explanation">
        <p><strong>@T["Current contribution"]:</strong> <bdi dir="ltr">@d.CurrentContribution.ToString("N2") @Model.Currency</bdi> · @period</p>
        <p>@T["Contribution means sales minus the unit costs entered here, before other business expenses."]</p>
        <p><a href="/business-costs">@T["Business costs"]</a> — @T["A full business operating result requires sales and costs across the business for the same period."]</p>
        @if (Model.Period.HasValue)
        { <p>@T["All quantities refer to the selected period. Unit cost is assumed unchanged. Expected sales are your assumption, not a prediction."]</p> }
        else
        { <p>@T["This older record did not save a comparison period. Its prices, unit cost, and quantities are historical snapshots."]</p> }
        <p>@T["This is a product contribution threshold, not a whole-business break-even point."]</p>
    </div>
    </details>
</section>
