<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Rebaz</title>
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48 64x64 256x256" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="256x256" href="~/images/branding/rebaz-symbol.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/" aria-label="Rebaz home"><img class="brand-logo" src="~/images/branding/rebaz-logo.png" asp-append-version="true" width="1178" height="339" alt="Rebaz" /></a>
            <nav aria-label="Main navigation">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/home">Home</a>
                    <a href="/products">Products</a>
                    <a href="/simulations/preview">Simulations</a>
                    <a href="/account/settings">Account</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="button button-quiet" type="submit">Log out</button>
                    </form>
                }
                else
                {
                    <a href="/account/login">Log in</a>
                    <a class="button button-small" href="/account/register">Get started</a>
                }
            </nav>
        </div>
    </header>
    <main id="main" class="container main-content">
        @if (TempData["Success"] is string message)
        {
            <div class="notice notice-success" role="status">@message</div>
        }
        @RenderBody()
    </main>
    <footer class="container site-footer"><a class="brand" href="/" aria-label="Rebaz home"><img class="brand-logo" src="~/images/branding/rebaz-logo.png" asp-append-version="true" width="1178" height="339" alt="Rebaz" /></a><span>A clearer view of your menu.</span></footer>
</body>
</html>
