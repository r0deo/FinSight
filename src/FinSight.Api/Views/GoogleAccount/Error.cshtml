@{ ViewData["Title"] = T["Google sign-in wasn't completed"].Value; }
<section class="panel message-panel"><h1>@T["Sign-in wasn't completed."]</h1>
    <p class="lead">@T["The request may have been cancelled or expired, or this Google account may already be connected elsewhere. Start again from the login page."]</p>
    @if (User.Identity?.IsAuthenticated == true)
    { <a class="button" href="/account/settings">@T["Back to Account settings"]</a> }
    else
    { <a class="button" href="/account/login">@T["Try signing in again"]</a> }
</section>
