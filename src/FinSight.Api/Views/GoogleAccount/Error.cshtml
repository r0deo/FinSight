@{ ViewData["Title"] = "Google sign-in wasn't completed"; }
<section class="panel message-panel"><h1>Sign-in wasn't completed.</h1>
    <p class="lead">The request may have been cancelled or expired, or this Google account may already be connected elsewhere. Start again from the login page.</p>
    @if (User.Identity?.IsAuthenticated == true)
    { <a class="button" href="/account/settings">Back to Account settings</a> }
    else
    { <a class="button" href="/account/login">Try signing in again</a> }
</section>
