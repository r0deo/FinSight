@model GoogleBusinessViewModel
@{ ViewData["Title"] = "Set up your business"; }
<section class="panel message-panel"><p class="eyebrow">GOOGLE ACCOUNT CONNECTED</p><h1>Tell us about your business.</h1>
    <p>Signing up as @ViewData["GoogleEmail"]. Complete these details to create your Owner account.</p>
    <form asp-action="Business" method="post">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <div class="field"><label asp-for="BusinessName"></label><input asp-for="BusinessName" maxlength="100" /><span asp-validation-for="BusinessName"></span></div>
        <div class="field"><label asp-for="Location"></label><input asp-for="Location" maxlength="200" /><span asp-validation-for="Location"></span></div>
        <div class="field"><label asp-for="Currency"></label><input asp-for="Currency" maxlength="3" /><small>Three-letter code, such as IQD or USD.</small><span asp-validation-for="Currency"></span></div>
        <div class="field"><label asp-for="ContactInformation"></label><input asp-for="ContactInformation" maxlength="200" /><span asp-validation-for="ContactInformation"></span></div>
        <button class="button" type="submit">Create business</button>
    </form>
</section>
