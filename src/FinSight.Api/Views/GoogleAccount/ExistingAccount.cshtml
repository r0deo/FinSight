@{ ViewData["Title"] = T["Sign in before linking"].Value; }
<section class="panel message-panel"><h1>@T["Sign in to your existing account."]</h1>
    <p class="lead">@T["We never connect accounts just because their email addresses match. Sign in using your existing Rebaz login, then choose Connect Google in Account settings."]</p>
    <a class="button" href="/account/login?returnUrl=%2Faccount%2Fsettings">@T["Sign in to your account"]</a>
    <p class="form-footer"><a href="/account/resend-confirmation">@T["Need to confirm your existing email?"]</a></p>
</section>
