@{ ViewData["Title"] = "Sign in before linking"; }
<section class="panel message-panel"><h1>Sign in to your existing account.</h1>
    <p class="lead">We never connect accounts just because their email addresses match. Sign in using your existing Rebaz login, then choose Connect Google in Account settings.</p>
    <a class="button" href="/account/login?returnUrl=%2Faccount%2Fsettings">Sign in to your account</a>
    <p class="form-footer"><a href="/account/resend-confirmation">Need to confirm your existing email?</a></p>
</section>
